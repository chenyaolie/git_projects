<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hgnu.diningexpensemanagementsystem.mapper.AdminMapper">
    <select id="selectByAdminId" resultType="AdminDEMS">
        SELECT * FROM AdminDEMS WHERE AdminId = #{adminId}
    </select>
    <update id="updatePassword">
        UPDATE AdminDEMS SET Password=#{password} WHERE AdminId=#{adminId}
    </update>
</mapper>
